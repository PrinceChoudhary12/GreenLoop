# ==============================================================================
# GreenLoop Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env in your production or staging deployment environment:
#   cp .env.production.example .env
# Replace all placeholder values with secure, freshly generated secrets.
# Never commit the populated .env file to version control.
# ==============================================================================

# Application Environment
APP_NAME=GreenLoop
APP_VERSION=1.0.0
APP_ENV=production
DEBUG=False

# Host and Port Configuration
PORT=80
HOST=0.0.0.0

# Database Configuration (PostgreSQL Target)
POSTGRES_DB=greenloop
POSTGRES_USER=greenloop_app
# Generate a strong password: openssl rand -hex 24
POSTGRES_PASSWORD=replace_with_strong_database_password_min_24_chars
# Constructed connection string for the backend service container
DATABASE_URL=postgresql://greenloop_app:replace_with_strong_database_password_min_24_chars@db:5432/greenloop

# Security and Cryptographic Tokens
# Generate a cryptographically secure random secret: openssl rand -hex 32
SECRET_KEY=replace_with_strong_secret_key_minimum_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Rate Limiting & Request Security
RATE_LIMIT_ENABLED=True
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_API_PER_MINUTE=150
ENABLE_SECURITY_HEADERS=True
MAX_REQUEST_BODY_BYTES=10485760

# Allowed CORS Origins (comma-separated or JSON list of client domains)
BACKEND_CORS_ORIGINS=https://greenloop.org,https://staging.greenloop.org,http://localhost

# File Upload Storage
UPLOAD_DIR=/app/uploads
MAX_IMAGE_SIZE_BYTES=5242880

# ASGI Concurrency
WEB_CONCURRENCY=2
