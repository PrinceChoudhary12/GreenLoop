# GreenLoop Environment Configuration (Example)
# Copy this file to .env and adjust variables as needed for your environment.

# Application Metadata
APP_NAME=GreenLoop
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1

# Server Settings
HOST=127.0.0.1
PORT=8000

# Logging
# Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Database Configuration
# Local development default: SQLite
# Future production: postgresql+psycopg2://user:password@localhost:5432/greenloop
DATABASE_URL=sqlite:///./greenloop.db

# CORS Allowed Origins (Comma-separated list or JSON array)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
